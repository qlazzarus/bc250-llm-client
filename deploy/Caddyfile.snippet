# Add inside the existing site block. Network access is controlled by the
# router and server firewall; these routes have no Caddy IP restriction.
handle /llm/api/* {
    uri strip_prefix /llm
    reverse_proxy 127.0.0.1:8010 {
        flush_interval -1
    }
}

handle_path /llm/* {
    root * /opt/bc250-llm-client/frontend/dist
    try_files {path} /index.html
    file_server
}
