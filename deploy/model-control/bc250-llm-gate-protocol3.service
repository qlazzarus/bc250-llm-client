# Candidate only: migrate state and coordinate all consumers before use.
[Unit]
Description=BC-250 LLM protocol 3 admission gate
After=network.target

[Service]
Type=simple
User=ai-studio
Group=ai-studio
WorkingDirectory=/opt/bc250-llm-gate
ExecStart=/opt/bc250-llm-gate/.venv/bin/uvicorn gate_candidate.runtime:create_gate_app --factory --host 127.0.0.1 --port 8081 --workers 1
LoadCredential=admin-key:/etc/bc250-model-control/gate-admin-key
LoadCredential=client-key:/etc/bc250-model-control/gate-client-key
LoadCredential=studio-key:/etc/bc250-model-control/gate-studio-key
LoadCredential=switch-key:/etc/bc250-model-control/switch-gate-key
LoadCredential=llm-key:/etc/bc250-model-control/llm-key
Restart=on-failure
RestartSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bc250-llm-gate

[Install]
WantedBy=multi-user.target
