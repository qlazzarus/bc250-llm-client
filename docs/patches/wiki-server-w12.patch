+def document_revision(row):
+    fields = [row[k] for k in ("id", "title", "content", "category", "created_at", "updated_at")]
+    encoded = json.dumps(fields, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+    return "sha256:" + hashlib.sha256(encoded).hexdigest()
+
+
+def next_updated_at(previous):
+    # Advance even if the system clock moves backwards or updates share a tick.
+    try:
+        old = datetime.fromisoformat(previous)
+        if old.tzinfo is None:
+            raise ValueError("timezone required")
+        return max(datetime.now(timezone.utc), old + timedelta(microseconds=1)).isoformat()
+    except (ValueError, OverflowError) as exc:
+        raise HTTPException(409, detail={"code": "wiki_revision_invalid", "message": "Invalid document timestamp"}) from exc
+
