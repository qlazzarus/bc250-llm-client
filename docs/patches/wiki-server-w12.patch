+def update_document_transaction(doc_id: int, doc: DocumentInput, expected_revision: str | None):
+    with connect() as db:
+        db.execute("BEGIN IMMEDIATE")
+        old = db.execute("SELECT * FROM documents WHERE id=?", (doc_id,)).fetchone()
+        if old is None:
+            raise HTTPException(404, "Document not found")
+        if expected_revision is not None and document_revision(old) != expected_revision:
+            raise HTTPException(409, detail={"code": "wiki_revision_conflict", "message": "Document revision changed"})
+        now = next_updated_at(old["updated_at"])
+        db.execute("""UPDATE documents SET title=?,content=?,category=?,updated_at=? WHERE id=?""",
+                   (doc.title, doc.content, doc.category, now, doc_id))
+        row = db.execute("SELECT * FROM documents WHERE id=?", (doc_id,)).fetchone()
+        revision = document_revision(row)
