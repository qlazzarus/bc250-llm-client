+def _uid_threads(uid, gid, gate_pid):
+    """Inspect visible thread credentials; disappearing entries abort the scan."""
+    found = []
+    for process in PROC.iterdir():
+        if not process.name.isdecimal():
+            continue
+        pid = int(process.name)
+        for task in (process / 'task').iterdir():
+            if not task.name.isdecimal():
+                raise ValueError('스레드 식별자 형식 오류')
+            tid = int(task.name)
+            status = (task / 'status').read_text(encoding='utf-8', errors='surrogateescape')
+            values = [line.split()[1:] for line in status.splitlines() if line.startswith('Uid:')]
+            if (len(values) != 1 or len(values[0]) != 4
+                    or any(not value.isdecimal() for value in values[0])):
+                raise ValueError('스레드 UID를 확인하지 못했습니다.')
+            if uid not in (int(value) for value in values[0]):
+                continue
+            if pid != gate_pid:
+                raise ValueError('gate와 같은 UID를 사용하는 다른 프로세스가 있습니다.')
+            process_credentials(status, uid, gid)
+            found.append((pid, tid, starttime(tid)))
+    if not found or not any(pid == gate_pid and tid == gate_pid for pid, tid, _ in found):
+        raise ValueError('gate 주 스레드를 확인하지 못했습니다.')
+    return tuple(sorted(found))
+
+
+def observe_exclusive(unit='bc250-llm-gate.service', client_user='yeppyshiba'):
+    """Momentarily reject other visible processes using the gate UID.
+
+    This scan does not prevent later process creation, socket transfer, hidden
+    tasks, or provide a continuous isolation guarantee.
+    """
+    for _ in range(5):
+        try:
+            identity = observe(unit=unit, client_user=client_user)
+            pid, _, uid, gid = identity
+            before = _uid_threads(uid, gid, pid)
+            after = _uid_threads(uid, gid, pid)
+            if before != after or observe(unit=unit, client_user=client_user) != identity:
+                raise ValueError('gate 스레드 또는 세대가 관찰 중 변경됐습니다.')
+            return identity
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+    raise ValueError('프로세스 종료 경합으로 gate UID를 확인하지 못했습니다.')
+
+
 if __name__ == '__main__':
