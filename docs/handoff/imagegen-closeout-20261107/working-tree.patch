+        raise ValueError('root와 유효한 PID가 필요합니다.')
+    watched = watched_paths(data_root, database)
+    before = process_threads(pid)
+    result = {tid: observe_known_thread(pid, tid, data_root, database) for tid in before}
+    if process_threads(pid) != before or watched_paths(data_root, database) != watched:
+        raise ValueError('검사 중 스레드 목록 또는 데이터 경로가 변경됐습니다.')
+    return result
+
+
+def process_uids(pid):
+    text = (PROC / str(pid) / 'status').read_text(encoding='utf-8', errors='surrogateescape')
