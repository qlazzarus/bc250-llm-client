+    task.stat()
+    if process_starttime(pid) != process_started or process_starttime(tid) != thread_started:
+        raise ValueError('검사 중 프로세스 또는 스레드가 변경됐습니다.')
+    return result
+
+
+def process_threads(pid):
+    entries = (PROC / str(pid) / 'task').iterdir()
+    tids = [int(entry.name) for entry in entries if entry.name.isdecimal()]
+    if not tids or pid not in tids:
+        raise ValueError('프로세스 스레드 목록이 올바르지 않습니다.')
+    return {tid: process_starttime(tid) for tid in tids}
+
+
+def observe_process_threads(pid, data_root, database):
+    """Observe a process's listed threads twice; this is not a writer fence."""
