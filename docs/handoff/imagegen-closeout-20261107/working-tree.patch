+
+
+def observe_known_thread(pid, tid, data_root, database):
+    """Observe one explicitly identified thread; this does not enumerate threads."""
+    if type(pid) is not int or type(tid) is not int or pid <= 1 or tid <= 1:
+        raise ValueError('유효한 프로세스와 스레드 ID가 필요합니다.')
