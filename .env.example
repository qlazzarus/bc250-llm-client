# Bind only to loopback; Caddy is the public entry point.
APP_HOST=127.0.0.1
APP_PORT=8010
DATABASE_PATH=./data/bc250-llm-client.db

# Local mode relies on the router and server firewall for network restrictions. Add the server LAN IP or trusted DNS name.
APP_AUTH_MODE=local
APP_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep empty in local mode.
CORS_ORIGINS=

# Never expose these to Vite or any frontend environment variable.
LLM_GATE_URL=http://127.0.0.1:8081
LLM_GATE_API_KEY=replace-with-gate-key
LLM_TIMEOUT_SECONDS=180
MAX_REQUEST_BYTES=65536
MAX_HISTORY_MESSAGES=20
MAX_COMPLETION_TOKENS=2048
DEFAULT_MAX_TOKENS=512
MAX_CONCURRENT_GENERATIONS=2
STORE_REASONING_CONTENT=false
# Qwen3.5 default: reserve output tokens for the user-visible final answer.
LLM_DISABLE_REASONING=true
# Use a value confirmed from llama-server's actual context setting, not model marketing specs.
LLM_CONTEXT_TOKENS=8192
LLM_CONTEXT_SAFETY_TOKENS=512
# Optional: pin one ID exposed by /v1/models. Leave blank to use the first available model.
LLM_MODEL_ID=
RESPONSE_LENGTH_SHORT_TOKENS=512
RESPONSE_LENGTH_MEDIUM_TOKENS=1024
RESPONSE_LENGTH_LONG_TOKENS=2048
# image_prompt mode returns a validated generation JSON object, not an image.
IMAGE_PROMPT_MAX_TOKENS=512
# Disabled until the server-side Studio preflight has been checked. Never expose this key to Vite.
IMAGEGEN_ENABLED=false
IMAGEGEN_ALLOW_FAKE=false
IMAGEGEN_URL=http://127.0.0.1:8090
IMAGEGEN_API_KEY=
IMAGEGEN_TIMEOUT_SECONDS=20
MAX_IMAGE_JOBS=10
# The client proxies only these bounded image files after local job ownership checks.
MAX_IMAGE_ASSET_BYTES=20971520
# Repeated status polls within this interval return the durable local state without contacting Studio.
IMAGE_JOB_POLL_MIN_INTERVAL_SECONDS=2
# Roleplay-only long-term memory. Summary work goes through the same LLM gate queue.
ROLEPLAY_SUMMARY_TRIGGER_TOKENS=5000
ROLEPLAY_SUMMARY_KEEP_RECENT_TURNS=6
ROLEPLAY_SUMMARY_MAX_TOKENS=512
